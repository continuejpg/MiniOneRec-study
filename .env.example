# MiniOneRec-Reproduction -- environment overrides
#
# Copy to .env and edit, or export these in your shell before running a launcher.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# Every launcher sources scripts/common.sh, which resolves paths from these
# variables. Nothing here changes training or evaluation hyperparameters -- those
# live in the individual launchers and are intentionally not configurable from
# the environment.

# ---- required: the upstream Qwen2.5-0.5B weights ----------------------------
# Not shipped with this repository. Launchers that need an LLM fail loud if unset:
#   : "${BASE_MODEL:?set BASE_MODEL to the Qwen2.5-0.5B model path}"
export BASE_MODEL=/path/to/Qwen2.5-0.5B

# ---- where experiment outputs go --------------------------------------------
# Defaults to $PROJECT_ROOT/runs. Point this at an existing runs/ backup if you
# want to run the analysis/ provenance scripts without retraining.
export RUN_ROOT=/path/to/runs

# ---- optional overrides ------------------------------------------------------
# PROJECT_ROOT is intentionally NOT listed: it is derived from the repository
# itself (parent of scripts/), so a fresh clone works with no configuration.
export DATA_ROOT=/path/to/MiniOneRec-Reproduction/data/Amazon
export CATEGORY=Industrial_and_Scientific
export PY=python
